{
  "name": "vscode-lofi",
  "displayName": "Lofi Radio",
  "description": "Chill internet radio in your VS Code sidebar and status bar.",
  "version": "0.0.1",
  "publisher": "deepu0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepu0/vscode-lofi.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "lofi",
    "music",
    "radio",
    "focus",
    "chill"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lofi",
          "title": "Lofi Radio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lofi": [
        {
          "type": "webview",
          "id": "lofi.player",
          "name": "Player"
        }
      ]
    },
    "commands": [
      {
        "command": "lofi.togglePlay",
        "title": "Play / Pause",
        "category": "Lofi Radio"
      },
      {
        "command": "lofi.next",
        "title": "Next Station",
        "category": "Lofi Radio"
      },
      {
        "command": "lofi.previous",
        "title": "Previous Station",
        "category": "Lofi Radio"
      },
      {
        "command": "lofi.pickStation",
        "title": "Pick Station…",
        "category": "Lofi Radio"
      },
      {
        "command": "lofi.toggleMute",
        "title": "Toggle Mute",
        "category": "Lofi Radio"
      }
    ],
    "keybindings": [
      {
        "command": "lofi.togglePlay",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      }
    ],
    "configuration": {
      "title": "Lofi Radio",
      "properties": {
        "lofiRadio.resumeOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the Lofi Radio player with your last station ready when VS Code starts. VS Code blocks audio without a user gesture, so this only reveals the player ready to play; press the play button (or Ctrl+Alt+L / Cmd+Alt+L) once to start audio."
        },
        "lofiRadio.customStations": {
          "type": "array",
          "default": [],
          "description": "Extra radio stations, merged after the built-in list. Each entry needs id, name and streamUrl; genre and homepage are optional.",
          "markdownDescription": "Extra radio stations, merged after the built-in list. Each entry needs `id`, `name` and `streamUrl` (an http(s) URL); `genre` and `homepage` are optional.\n\nExample:\n\n```json\n\"lofiRadio.customStations\": [\n  {\n    \"id\": \"my-lofi\",\n    \"name\": \"My Lofi\",\n    \"streamUrl\": \"https://example.com/stream.mp3\",\n    \"genre\": \"Lofi\",\n    \"homepage\": \"https://example.com\"\n  }\n]\n```",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "streamUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the station."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the player."
              },
              "streamUrl": {
                "type": "string",
                "description": "Direct http(s) audio stream URL."
              },
              "genre": {
                "type": "string",
                "description": "Optional genre label."
              },
              "homepage": {
                "type": "string",
                "description": "Optional station homepage URL."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "experiment": "npm run build && node dist/experiment/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
